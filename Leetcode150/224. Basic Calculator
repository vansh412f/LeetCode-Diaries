class Solution {
    public int calculate(String s) {
        Stack<Integer> st = new Stack<>();
        int num = 0;
        int res = 0;
        int sign = 1;
        for(int i =0; i< s.length(); i++){
            char ch = s.charAt(i);
            if(ch == ' ') continue;
            else if(Character.isDigit(ch)){
                num = num*10;
                num += ch - '0';
            } else if(ch == '+'){
                res += sign* num;
                sign = 1;
                num =0;
            }  else if(ch == '-'){
                res += sign* num;
                sign = -1;
                num =0;
            } else if( ch == '('){
                st.push(res);
                st.push(sign);

                res= 0;
                sign = 1;
                num = 0;
            } else if ( ch == ')'){
                res += sign*num;
                num =0;

                res *= st.pop();
                res += st.pop();
            }

        }
        res += sign* num;
        return res;
    }
}
