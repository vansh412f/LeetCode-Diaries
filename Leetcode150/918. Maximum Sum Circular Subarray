class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int max1 = Integer.MIN_VALUE;
        int sum =0;
        int n = nums.length ;
        for(int i=0; i< n ; i++){
            sum += nums[i];
            max1 = Math.max(max1, sum);
            if(sum < 0){
                sum =0;
            }
        }
        if(max1 <0) return max1;
        sum =0;
        int min = Integer.MAX_VALUE;
        int total = 0;
        for(int i =0; i< n; i++){
            total += nums[i];
            sum += nums[i];
            min = Math.min(sum, min);
            if(sum > 0) sum  =0;
        }

        int max2 = total - min;
        return Math.max(max1, max2);
    }
}
