class Solution {
    public List<String> summaryRanges(int[] nums) {
        List<String> res = new ArrayList<>();
        if(nums.length == 0) return res;
        int start = nums[0];
        int end = nums[0];
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] == end + 1) {
                end = nums[i];
                continue;
            } else {
                StringBuilder sb = new StringBuilder();
                if (start == end) {
                    sb.append(start);
                } else {
                    sb.append(start);
                    sb.append("->");
                    sb.append(end);
                }
                res.add(sb.toString());
                start = nums[i];
                end = nums[i];
            }
        }
        StringBuilder sb = new StringBuilder();
        if (start == end) {
            sb.append(start);
        } else {
            sb.append(start);
            sb.append("->");
            sb.append(end);
        }
        res.add(sb.toString());
        return res;
    }
}
