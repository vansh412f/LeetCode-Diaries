class Solution {
    public int[] plusOne(int[] digits) {
        int size = digits.length;
        
        for(int i = size-1; i>=0 ; i--){
            digits[i] = digits[i] + 1;
            if(digits[i] != 10) break;
            else digits[i] = 0;
        }
        if(digits[0] != 0) return digits;
        int [] res = new int[size+1];
        res[0] = 1;
        for(int i =1; i< size+1; i++){
            res[i] = digits[i-1];
        }
        return res;
    }
}
