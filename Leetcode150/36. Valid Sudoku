class Solution {
    public boolean isValidSudoku(char[][] board) {
        HashMap<Integer, HashSet<Character>> row = new HashMap<>();
        HashMap<Integer, HashSet<Character>> col = new HashMap<>();
        HashMap<Integer, HashSet<Character>> box = new HashMap<>();
        for(int i =0; i< 9; i++){
            row.put(i,  new HashSet<>());
            col.put(i,  new HashSet<>());
            box.put(i+1,  new HashSet<>());
        }
        for(int i =0; i< 9; i++){
            for(int j = 0; j< 9; j++){
                char ch = board[i][j];
                if(ch == '.'){
                    continue;
                }
                if(row.get(i).contains(ch)) return false;
                else row.get(i).add(ch);
                if(col.get(j).contains(ch)) return false;
                else col.get(j).add(ch);

                int q =0;
                if(i<3){
                    if(j< 3) q= 1;
                    else if( j< 6) q =2;
                    else q = 3;
                }else if(i<6){
                    if(j< 3) q= 4;
                    else if( j< 6) q =5;
                    else q = 6;
                }else if(i< 9){
                    if(j< 3) q= 7;
                    else if( j< 6) q =8;
                    else q = 9;
                }
                
                if(box.get(q).contains(ch)) return false;
                else box.get(q).add(ch);
            }
        }
        return true;
    }
}
