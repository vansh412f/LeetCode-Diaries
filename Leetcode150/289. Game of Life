class Solution {
    public void gameOfLife(int[][] board) {
        int [][] temp = new int[board.length][board[0].length];
        for(int i =0; i< temp.length ; i++){
            for(int j =0; j< temp[0].length; j++){
                temp[i][j] = board[i][j];
            }
        }

        for(int i =0; i< temp.length ; i++){
            for(int j =0; j< temp[0].length; j++){
                int count = getCount(temp, i, j);
                if(temp[i][j] == 1 && count < 2) board[i][j] = 0;
                else if(temp[i][j] == 1 && (count == 2 || count == 3)) board[i][j] =1;
                else if(temp[i][j] == 1 && count > 3) board[i][j] = 0;
                else if(temp[i][j] == 0 && count == 3) board[i][j] =1;
            }
        }
    }
    public int getCount(int [][] board, int i, int j){
        int count =0;
        if(i>0 && j>0){
            if(board[i-1][j-1] == 1) count++;
        }
        if(i>0){
            if(board[i-1][j] == 1) count++;
        }
        if(i>0 && j< board[0].length-1){
            if(board[i-1][j+1] == 1) count++;
        }
        if(i< board.length-1 && j>0){
            if(board[i+1][j-1] == 1) count++;
        }
        
        if(i< board.length-1){
            if(board[i+1][j] == 1) count++;
        }
        if(i< board.length-1 && j < board[0].length -1){
            if(board[i+1][j+1] == 1) count++;
        }
        if(j>0){
            if(board[i][j-1] == 1) count++;
        }
        if(j< board[0].length-1){
            if(board[i][j+1] == 1) count++;
        }
        return count;
    }
}
