class Solution {
    public void rotate(int[] nums, int k) {
        int s = nums.length ;
        k = k%s;
        if(k ==0 || nums.length <=1) return;
        reverse(nums, 0, s-1);
        reverse(nums, 0, k-1);
        reverse(nums, k, s-1);
    }
    public void reverse(int [] nums, int left, int right){
        while(left < right ){
            int temp = nums[left];
            nums[left] = nums[right];
            nums[right] = temp;
            left ++; right--;
        }
    }
}
