class Solution {
    
    HashSet<Integer> set = new HashSet<>();
    public int mincostTickets(int[] days, int[] costs) {

        for(int day: days){
            set.add(day);
        }
        int last = days[days.length-1] + 30;
        int [] dp = new int[last + 1];
        Arrays.fill(dp, -1);

        return recur(dp, days, costs, days[0]);
    }
    public int recur(int[] dp, int [] days, int[] costs, int curr){
        if(curr > days[days.length -1]){
            dp[curr] = 0;
            return 0;
        }
        if(dp[curr] != -1){
            return dp[curr];
        }
        if(!set.contains(curr)){
            dp[curr] = recur(dp, days, costs, curr + 1);
            return dp[curr];
        }
        int one = recur(dp, days, costs, curr + 1) + costs[0];
        int seven = recur(dp, days, costs, curr + 7) + costs[1];
        int thirty = recur(dp, days, costs, curr + 30) + costs[2];
        dp[curr] = Math.min(one, Math.min(seven, thirty));
        return dp[curr];
    }
}
