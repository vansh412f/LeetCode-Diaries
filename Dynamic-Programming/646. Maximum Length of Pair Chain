class Solution {
    public int findLongestChain(int[][] pairs) {
        int n = pairs.length;
        if(n==1) return 1;
        Arrays.sort(pairs, (a,b) -> Integer.compare(a[0] , b[0]));
        int prev[] = new int [n];
        Arrays.fill(prev, 1);
        int max = 1;
        for(int i =1; i< n ; i++){
            for(int j = 0; j< i; j++){
                if(pairs[i][0] > pairs[j][1]){
                    prev[i] = Math.max(prev[i], prev[j] + 1);
                    max = Math.max(prev[i], max);
                }
            }
        }
        return max;
    }
}
