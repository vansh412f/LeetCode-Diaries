class Solution {
    public int maxSelectedElements(int[] nums) {
        Arrays.sort(nums);
        HashMap<Integer, Integer> map = new HashMap<>();

        int ans = 0;
        for(int x : nums){
            map.put(x+1, map.getOrDefault(x,0) + 1);
            map.put(x, map.getOrDefault(x-1,0) + 1);

            ans = Math.max(ans, Math.max(map.get(x), map.get(x+1)));
        }
        return ans;

    }
}
