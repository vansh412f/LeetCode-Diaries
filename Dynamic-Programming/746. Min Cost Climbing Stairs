class Solution {
    public int minCostClimbingStairs(int[] cost) {
        int [] dp = new int[cost.length+2];
        dp[1] = cost[0];
        for(int i =2; i< cost.length + 2; i++){
            if(i== cost.length + 1){
                dp[i] = Math.min(dp[i-1], dp[i-2]);
                break;
            }
            dp[i] = Math.min(dp[i-1] , dp[i-2] ) + cost[i-1];
        }
        return dp[cost.length + 1];
    }
}
