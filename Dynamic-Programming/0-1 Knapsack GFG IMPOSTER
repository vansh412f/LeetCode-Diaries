class Solution {
    public int knapsack(int w, int val[], int wt[]) {
        int n = val.length;
        int [][] dp = new int[n][w+1];
        
        for(int i = 0; i< w+1; i++){
            if(wt[0] <= i){
                dp[0][i] = val[0];
            } else{
                dp[0][i] = 0;
            }
        }
        
        for(int i =1; i< n; i++){
            for(int j =0; j< w+1; j++){
                int pick =0;
                if(wt[i] <= j){
                    pick = val[i] + dp[i-1][j-wt[i]];
                }
                int nopick = dp[i-1][j];
        
                dp[i][j] = Math.max(pick, nopick);
            }
        }
        return dp[n-1][w];
    }
