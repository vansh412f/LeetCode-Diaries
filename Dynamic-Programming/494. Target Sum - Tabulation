class Solution {
    public int findTargetSumWays(int[] nums, int target) {
        int sum =0;
        for(int num:nums) sum+= num;
        int [][] dp = new int[nums.length][2*sum +1];
        for(int i =0; i< dp.length; i++){
            Arrays.fill(dp[i],-1);
        }
        return recur(nums, target, nums.length - 1, dp , sum);
    }
    public int recur(int[] nums, int target, int index, int[][] dp, int sum){
        if(target > sum || target < -sum)
            return 0;
        if(index == 0){
            if(target == 0 && nums[index] == 0) dp[index][target+sum] = 2;
            else if(target == nums[index] || target == -nums[index]) dp[index][target+sum] = 1;
            else dp[index][target+sum] = 0;
            return dp[index][target+sum] ;
        }
        int col = sum + target;
        if(dp[index][col] != -1) return dp[index][col] ;

        int pos = recur(nums, target- nums[index], index -1, dp, sum);
        int neg = recur(nums, target + nums[index], index -1, dp, sum);
        dp[index][col] = pos + neg;
        return dp[index][col] ;
    }
}
