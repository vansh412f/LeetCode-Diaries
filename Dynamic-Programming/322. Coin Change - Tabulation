class Solution {
    public int coinChange(int[] coins, int amount) {
        int n = coins.length;
        int [][] dp = new int[n][amount+1];

        for(int i=0; i< amount+1; i++){
            if(i % coins[0] == 0){
                dp[0][i] = i/coins[0];
            } else{
                dp[0][i] = (int)(1e9);
            }
        }

        for(int i =1; i< n; i++){
            for(int j =0; j< amount+1; j++){
                int pick =(int)(1e9);
                if(coins[i] <= j){
                    pick = 1 + dp[i][j-coins[i]];
                }
                int nopick = dp[i-1][j];
                dp[i][j] = Math.min(pick, nopick);
            }
        }

        int res = dp[n-1][amount];

        if(res == (int)(1e9)){
            return -1;
        } else{
            return res;
        }
    }
}
