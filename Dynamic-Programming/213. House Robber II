class Solution {
    public int rob(int[] nums) {
        if(nums.length == 1) return nums[0];
        int [] num1 = new int[nums.length - 1];
        int [] num2 = new int[nums.length - 1];
        for(int i = 1; i< nums.length; i++) num1[i-1] = nums[i];
        for(int i = 0; i< nums.length-1; i++) num2[i] = nums[i]; 
        return Math.max(profit(num1) , profit(num2));
    }
    public int profit(int [] nums){
        int [] dp = new int[nums.length+1];
        int prev1 = 0;
        int prev2 = nums[0];
        for(int i =2; i< nums.length +1 ; i++ ){
            int temp = Math.max(prev2 , prev1 + nums[i-1]);
            prev1 = prev2;
            prev2 = temp;
        }
        return prev2;
    }
}
