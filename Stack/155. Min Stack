class MinStack {
    private Stack<Integer> s, min;
    public MinStack() {
        s = new Stack<>();
        min = new Stack<>();
    }
    
    public void push(int value) {
        s.push(value);

        if (min.isEmpty()) {
            min.push(value);
        } else {
            if (value <= min.peek()) {
                min.push(value);
            }
        }
    }
    
    public void pop() {
        
        
        if(min.peek().equals(s.peek()) ){
            min.pop();
        }
        
        s.pop();
    }
    
    public int top() {
        return s.peek();
    }
    
    public int getMin() {
        return min.peek();
    }
}

