class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        HashMap<Integer, Integer> map = new HashMap<>();
        int [] res = new int[k];

        for(int num: nums){
            map.put(num, map.getOrDefault(num, 0) + 1);
        }
        for(int i = 0; i< k; i++){
            int max = 0;
            int f = 0;
            for(Map.Entry<Integer, Integer> entry: map.entrySet()){
                if(entry.getValue() > max){
                    max = entry.getValue();
                    f = entry.getKey();
                }

            }
            res[i] = f;
            map.remove(f);
        }
        return res;
    }
}
