class Solution {
    public int fib(int n) {
        int n1 = 0;
        int n2 = 1;
        if(n == 0) return 0;
        if(n==1 || n==2) return 1;
        int n3 = n1 + n2;
        for(int i =2; i<n; i++){
            n3 = n1 + n2;
            n1 = n2;
            n2 = n3;
        }
        n3 = n1+n2;
        return n3;
    }
}
