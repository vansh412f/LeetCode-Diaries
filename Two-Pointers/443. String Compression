class Solution {
    public int compress(char[] chars) {
        int idx = 0;
        for(int i =0; i< chars.length;i++){
            char curr = chars[i];
            int count =0;
            while(i< chars.length && curr == chars[i]){
                count++; i++;
            } 
            if( count == 1){
                chars[idx] = curr;
                idx++;
            } else{
                chars[idx] = curr;
                idx++;
                for(char digit: Integer.toString(count).toCharArray()){
                    chars[idx] = digit;
                    idx++;
                }
            }
            i--;
        }
        return idx;
    }
}
