class Solution {
    public int maxArea(int[] height) {
        int left =0;
        int right = height.length -1;
        int water =0;
        while(left< right){
            water = Math.max(Math.min(height[left], height[right]) * (right -left), water);
            if(height[left] < height[right]) left++;
            else right--;
        }
        return water;
    }
}
