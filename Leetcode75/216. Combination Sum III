class Solution {
    public List<List<Integer>> combinationSum3(int k, int n) {
        int [] num = new int [9];
        for(int i =0; i< 9; i++){
            num[i] = i+1;
        }
        List<List<Integer>> res = new ArrayList<>();
        backtrack(num, k , n, res, new ArrayList<>(), 0);
        return res;
    }
    public void backtrack(int[] num, int k, int n, List<List<Integer>> res, List<Integer> list, int index){
        if(k == 0 && n == 0){
            res.add(new ArrayList<>(list));
            return;
        }
        if(k < 0 || n < 0|| index == num.length) return;

        // pick
        list.add(num[index]);
        backtrack(num, k-1, n-num[index], res, list, index+1);
        list.remove(list.size() - 1);
        // no pick
        backtrack(num, k, n, res, list, index+1);
    }
}
