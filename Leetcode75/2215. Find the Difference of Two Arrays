class Solution {
    public List<List<Integer>> findDifference(int[] nums1, int[] nums2) {
        HashSet<Integer> s1 = new HashSet<>();
        HashSet<Integer> s2 = new HashSet<>();
        for(int num: nums1){
            s1.add(num);
        }
        for(int num: nums2){
            s2.add(num);
        }
        List<List<Integer>> ans = new ArrayList<>();
        ans.add(new ArrayList<>());
        ans.add(new ArrayList<>());
        for (int i : s1) {
            if (!s2.contains(i)) {
                ans.get(0).add(i);
            }
        }
        for (int i : s2) {
            if (!s1.contains(i)) {
                ans.get(1).add(i);
            }
        }
        return ans;
    }
}
