class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> res = new ArrayList<>();
        int max = Integer.MIN_VALUE;
        for(int num: candies){
            if(max< num){
                max = num;
            }
        }
        for(int num: candies){
            res.add(num + extraCandies >= max);
        }
        return res;
    }
}
