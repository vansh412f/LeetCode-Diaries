class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int max = piles[0];
        for(int num: piles) max = Math.max(num, max);
        int start = 1;
        int end = max;
        int ans = end;
        while(start<= end){
            int mid = end - (end - start)/2;
            int hour = 0;
            for(int b: piles){
                if(b < mid){
                    hour++;
                } else{
                    hour+= b/mid;
                    if(b%mid != 0) hour++;
                }
            }
            if(hour <= h){
                ans = Math.min(ans, mid);
                end = mid -1;
            } else{
                start = mid+1;
            }
        }
        return ans;
    }
}
