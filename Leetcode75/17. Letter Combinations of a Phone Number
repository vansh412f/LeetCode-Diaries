class Solution {
    public List<String> letterCombinations(String digits) {
        String [] num = new String[10];
        num[2] = "abc"; num[3] = "def"; 
        num[4] = "ghi"; num[5] = "jkl"; num[6] = "mno";
        num[7] = "pqrs"; num[8] = "tuv"; num[9] = "wxyz";

        List<String> res = new ArrayList<>();
        StringBuilder sb = new StringBuilder();
        back(digits, num, sb, res, 0);
        return res;
    }
    public void back(String digits, String [] num, StringBuilder curr, List<String> res, int digit){
        if(curr.length() == digits.length()){
            res.add(curr.toString());
            return;
        }
        int n = Character.getNumericValue(digits.charAt(digit));
        for(int i =0; i< num[n].length(); i++){
            curr.append(num[n].charAt(i));
            back(digits, num, curr, res,digit+1);
            curr.deleteCharAt(curr.length() - 1);
        }
    }
}
