class Solution {
    public int[] successfulPairs(int[] spells, int[] potions, long success) {
        Arrays.sort(potions);
        int[] res= new int[spells.length];
        for(int i =0; i< spells.length; i++){
            if(success < spells[i]) {
                res[i] = potions.length;
                continue;
            }
            long curr = success/(long)spells[i];
            if(success % spells[i] != 0){
                curr ++;
            }
            res[i] = find(curr, potions);
        }
        return res;
    }
    public int find(long target, int[] arr){
        int low = 0;
        int high = arr.length -1;
        if(target > arr[high]) return 0;
        if(target < arr[low]) return high + 1;
        while(low <= high){
            int mid = low + (high - low)/2;
            if(arr[mid] >= target ){
                if(mid ==0 || arr[mid-1] < target){
                    return arr.length - mid;
                } else{
                    high = mid - 1;
                }
            } else{
                low = mid + 1;
            }
        }
        return -1;
    }
}
