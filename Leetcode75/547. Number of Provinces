class Solution {
    public int findCircleNum(int[][] isConnected) {
        int n = isConnected.length;
        int count =0;
        boolean [] v = new boolean[n];
        for(int i =0; i<n; i++){
            if(!v[i]){
                count++;
                dfs(i, isConnected, v);
            }
        }
        return count;
    }
    public void dfs(int city, int[][] isConnected, boolean[] v){
        for(int i =0; i< v.length; i++){
            if(!v[i] && isConnected[city][i] == 1){
                v[i] = true;
                dfs(i, isConnected, v);
            }
        }
    }
}
