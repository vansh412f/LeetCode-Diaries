class Solution {
    public String digitSum(String s, int k) {
        int n = s.length();
        if(n <= k) return s;
        int sum =0;
        StringBuilder sb = new StringBuilder();

        for(int i =0; i< n; i++){
            if(i != 0 && i % k == 0 ){
                sb.append(Integer.toString(sum));
                sum =0;
            }
            if(i == n-1){
                sum+= s.charAt(i) - '0';
                sb.append(Integer.toString(sum));
            }
            sum += s.charAt(i) - '0';
        }
        String res = sb.toString();

        if(res.length() > k){
            res = digitSum(res, k);
        }
        return res;
    }
    
}
