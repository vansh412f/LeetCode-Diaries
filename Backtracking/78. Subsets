class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        backtrack(nums, res, 0, new ArrayList<>());
        return res;
    }
    public void backtrack(int [] nums, List<List<Integer>> res, int index, List<Integer> list){
        if(index == nums.length){
            res.add(list);
            return;
        }
        // pick
        list.add(nums[index]);
        backtrack(nums, res, index+1, list);
        list.remove(list.size() - 1);
        // nopick
        backtrack(nums, res, index+1, list);
    }
}
