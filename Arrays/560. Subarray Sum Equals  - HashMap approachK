class Solution {
    public int subarraySum(int[] nums, int k) {
        int n = nums.length;
        int curr = 0;
        int count =0;
        HashMap<Integer, Integer> map = new HashMap<>();
        map.put(0,1);
        for(int num: nums){
            curr += num;
            if(map.containsKey(curr - k)){
                count+= map.get(curr - k);
            }
            map.put(curr, map.getOrDefault(curr, 0) + 1);
        }

        return count;
    }
}
