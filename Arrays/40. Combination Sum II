class Solution {
    public List<List<Integer>> combinationSum2(int[] candidates, int target) {
        Arrays.sort(candidates);
        List<List<Integer>> res = new ArrayList<>();
        makecom(candidates, res, target, new ArrayList<>(),0);
        return res;
    }
    public void makecom(int []arr,List<List<Integer>> res,int target,List<Integer> com,int start){
        if(target == 0){
            res.add(new ArrayList<>(com));
            return;
        }
       for(int i =start; i< arr.length; i++){
            if (i > start && arr[i] == arr[i-1]) {
                continue;
            }
            if(arr[i] > target){
                break;
            }
            com.add(arr[i]);
            makecom(arr, res, target- arr[i],com, i+1 );
            com.remove(com.size()-1);

       }

    }
}
