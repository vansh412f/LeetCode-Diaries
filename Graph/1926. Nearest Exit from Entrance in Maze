class Solution {
    public int nearestExit(char[][] maze, int[] entrance) {
        int m = maze.length;
        int n = maze[0].length;
        int ei = entrance[0];
        int ej = entrance[1];
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[] { ei, ej, 0 });
        maze[ei][ej] = '+';

        while (!q.isEmpty()) {
            int[] e = q.poll();
            int i = e[0];
            int j = e[1];
            int d = e[2];
            if ((i == 0 || j == 0 || i == m - 1 || j == n - 1) && d!=0) return d;
            if (i > 0 && maze[i - 1][j] == '.') {
                q.offer(new int[] { i - 1, j, d + 1 });
                maze[i - 1][j] = '+';
            }
            if (j > 0 && maze[i][j - 1] == '.') {
                q.offer(new int[] { i, j - 1, d + 1 });
                maze[i][j - 1] = '+';
            }
            if (i < m - 1 && maze[i + 1][j] == '.') {
                q.offer(new int[] { i + 1, j, d + 1 });
                maze[i + 1][j] = '+';
            }
            if (j < n - 1 && maze[i][j + 1] == '.') {
                q.offer(new int[] { i, j + 1, d + 1 });
                maze[i][j + 1] = '+';
            }
        }
        return -1;
    }
}
