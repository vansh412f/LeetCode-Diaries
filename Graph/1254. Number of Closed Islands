class Solution {
    public int closedIsland(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        for(int i =0; i< m ; i++){
            if(grid[i][0] == 0) fill(grid, i, 0);
            if(grid[i][n-1] == 0) fill(grid, i, n-1);
        }
        for(int i =0; i< n ; i++){
            if(grid[0][i] == 0) fill(grid, 0,i);
            if(grid[m-1][i] == 0) fill(grid, m-1, i);
        }
        int count= 0;
        for(int i =1; i< m-1; i++){
            for(int j = 1; j< n-1; j++){
                if(grid[i][j] == 0){
                    count++;
                    fill(grid, i, j);
                }
            }
        }
        return count;
    }
    public void fill(int [][] grid, int i, int j){
        if(i<0 || j<0 || i>= grid.length || j >= grid[0].length || grid[i][j] == 1) return;
        grid[i][j] = 1;
        fill(grid, i-1, j);
        fill(grid, i+1, j);
        fill(grid, i, j-1);
        fill(grid, i, j+1);
    }
}
