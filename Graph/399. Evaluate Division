class Solution {
    public double[] calcEquation(List<List<String>> equations, double[] values, List<List<String>> queries) {
        HashMap<String, HashMap<String, Double>> map = new HashMap<>();
        for(int i =0 ; i< equations.size(); i++){
            String dividend = equations.get(i).get(0);
            String divisor = equations.get(i).get(1);
            double value = values[i];
            if(!map.containsKey(dividend)){
                map.put(dividend, new HashMap<String, Double>());
            }
            if(!map.containsKey(divisor)){
                map.put(divisor, new HashMap<String, Double>());
            }
            map.get(dividend).put(divisor, value);
            map.get(divisor).put(dividend, 1/value);
        }
        double []res = new double[queries.size()];

        for(int i =0; i< queries.size(); i++){
            String dividend = queries.get(i).get(0);
            String divisor = queries.get(i).get(1);
            if(!map.containsKey(dividend) || !map.containsKey(divisor)){
                res[i] = -1.0;
            } else if(dividend == divisor){
                res[i] = 1.0;
            } else{
                HashSet<String> vis = new HashSet<>();
                res[i] = dfs(dividend, divisor, 1, vis, map);
            }
        }
        return res;
    }
    public double dfs(String dividend, String divisor, double prod,HashSet<String> vis ,HashMap<String, HashMap<String, Double>> map){
        double res = -1.0;
        vis.add(dividend);
        if(map.get(dividend).containsKey(divisor)){
            res = prod* map.get(dividend).get(divisor);
        }else{
            for(String neighbour: map.get(dividend).keySet()){
                if(!vis.contains(neighbour)){
                    res = dfs(neighbour, divisor, prod* map.get(dividend).get(neighbour), vis, map);
                    if(res != -1.0){
                        break;
                    }
                }
            }
        }
        vis.remove(dividend);
        return res;
    }
}
