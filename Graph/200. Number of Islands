class Solution {
    public int numIslands(char[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int count =0;
        boolean [][] vis = new boolean[m][n];
        for(int i =0; i< m ;i++){
            for(int j =0; j< n; j++){
                if(!vis[i][j] && grid[i][j] == '1'){
                    dfs(vis, grid, i, j);
                    count++;
                }
            }
        }
        return count;
    }
    public void dfs(boolean [][] vis, char[][] grid, int a, int b){
        Queue<int []> q = new LinkedList<>();
        q.offer(new int[]{a,b});
        while(!q.isEmpty()){
            int [] curr = q.poll();
            int i = curr[0];
            int j = curr[1];
            vis[i][j] = true;
            if(i < grid.length-1 && !vis[i+1][j] && grid[i+1][j] == '1'){
                vis[i+1][j] = true;
                q.offer(new int[]{i+1, j});
            }
            if(j < grid[0].length-1 && !vis[i][j+1] && grid[i][j+1] == '1'){
                vis[i][j+1] = true;
                q.offer(new int[]{i, j+1});
            }
            if(i > 0 && !vis[i-1][j] && grid[i-1][j] == '1'){
                vis[i-1][j] = true;
                q.offer(new int[]{i-1, j});
            }
            if(j > 0 && !vis[i][j-1] && grid[i][j-1] == '1'){
                vis[i][j-1] = true;
                q.offer(new int[]{i, j-1});
            }

        }
    }
}
