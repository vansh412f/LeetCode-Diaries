class Solution {
    public int countIslands(int[][] grid, int k) {
        int m = grid.length ;
        int n = grid[0].length;
        int count =0;
        for(int i =0; i< m; i++){
            for(int j =0; j<n; j++){
                if(grid[i][j] != 0){
                    long curr  = bfs(grid, i, j);
                    if(curr % k == 0) count ++;
                }
            }
        }
        return count;
    }
    public long bfs(int [][] grid, int i, int j){
        if(i<0 || j<0 || i>= grid.length || j>= grid[0].length || grid[i][j] == 0) return 0;
        long val = grid[i][j];
        grid[i][j] =0;
        long left = bfs(grid, i, j-1);
        long right = bfs(grid, i, j+1);
        long up = bfs(grid, i+1, j);
        long bottom = bfs(grid, i-1, j);
        return val + left + right + up + bottom;
    }
}
