class Solution {
    public int minReorder(int n, int[][] connections) {
        List<List<Integer>> res = new ArrayList<>();
        for(int i =0; i< n; i++){
            res.add(new ArrayList<>());
        }
        for(int [] arr: connections){
            int a = arr[0];
            int b = arr[1];
            res.get(a).add(b);
            res.get(b).add(-a);
        }
        return dfs(res, 0, new boolean[n]);
    }
    public int dfs(List<List<Integer>> res, int node, boolean[] vis){
        int change  =0;
        vis[node] = true;
        for(int dest: res.get(node)){
            if(!vis[Math.abs(dest)]){
                change += dfs(res, Math.abs(dest), vis);
                if(dest>0){
                    change ++;
                }
            }
        }
        return change;
    }
}
