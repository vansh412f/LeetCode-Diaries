class Solution {
    public int count =-1;
    public int fresh =0;
    public int orangesRotting(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        Queue<int []> q = new LinkedList<>();
        for(int i =0; i< m; i++){
            for(int j =0; j<n; j++){
                if(grid[i][j] == 2){
                    q.offer(new int[]{i,j});
                } else if(grid[i][j] == 1){
                    fresh++;
                }
            }
        }
        if(fresh == 0) return 0;

        bfs(grid, q);

        if(fresh>0) return -1;

        return count;
    }
    public void bfs(int [][] grid, Queue<int []> q){
        while(!q.isEmpty()){
            int size = q.size();
            count++;
            for(int c =0; c< size; c++){
                int [] arr = q.poll();
                int i = arr[0];
                int j =arr[1];
                if( i>0 && grid[i-1][j] == 1){
                    grid[i-1][j] = 2;
                    q.offer(new int[]{i-1, j});
                    fresh--;
                }
                if( j>0 && grid[i][j-1] == 1){
                    grid[i][j-1] = 2;
                    q.offer(new int[]{i, j-1});
                    fresh--;
                }
                if( i < grid.length-1 && grid[i+1][j] == 1){
                    grid[i+1][j] = 2;
                    q.offer(new int[]{i+1, j});
                    fresh--;
                }
                if( j < grid[0].length-1 && grid[i][j+1] == 1){
                    grid[i][j+1] = 2;
                    q.offer(new int[]{i, j+1});
                    fresh--;
                }
            }
        }
    }
}
